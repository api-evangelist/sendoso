{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sendoso Sending Platform Inventory Teams API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Team Budget",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.sendoso.com/api/v2/teams/budget"
          },
          "docs": "Returns the current budget balance and allocation for the authenticated team."
        }
      ]
    }
  ],
  "bundled": true
}